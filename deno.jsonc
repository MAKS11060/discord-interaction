{
  "name": "@maks11060/discord-interactions",
  "version": "0.0.0",
  "lock": false,
  "tasks": {
    "dev": "deno run -A --watch-hmr examples/main.ts",
    "test": "deno test -A",
    "check": "deno publish --dry-run --allow-dirty",
    "ci": {
      "dependencies": [
        "test",
        "check"
      ]
    },
  },
  "imports": {
    "@std/bytes": "jsr:@std/bytes@^1.0.5",
    "@std/collections": "jsr:@std/collections@^1.0.10",
    "@std/encoding": "jsr:@std/encoding@^1.0.7",
    "discord-api-types": "npm:discord-api-types@^0.38.1",
    "hono": "npm:hono@^4.7.8",
    "zod": "npm:zod@^3.24.3"
  },
  "exports": {
    ".": "./mod.ts",
    "./hono": "./src/adapter/hono.ts",
    "./cli": "./cli/cli.ts"
  },
  "publish": {
    "include": [
      "**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      ".github",
      "examples",
      "**/*.test.ts"
    ]
  },
  "unstable": [
    "kv"
  ]
}